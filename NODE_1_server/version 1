const unsigned long NODE_TIMEOUT_MS = 15000;    // node is "offline" after this long without data
const size_t LOG_MAX_BYTES = 32768;             // rotate a node's log file above this size

// ---------- State ----------
WebServer server(80);

struct NodeState {
  bool seen = false;
  unsigned long lastSeenMs = 0;
  String lastSeenTime = "";
  String readingsJson = "{}";   // latest readings as a JSON object
  String pendingCmd = "";       // command waiting for the node to pick up
};
NodeState nodes[NODE_COUNT];

unsigned long lastWifiTry = 0, lastTimePrint = 0;


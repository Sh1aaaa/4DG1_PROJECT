<script>
// ===== Configuration: edit names, commands and alert limits =====
const CONFIG = {
  refreshMs: 5000,
  historyLimit: 60,
  nodes: {
    NODE_01: { name: 'Entrance',  cmds: [['led_on','LED on'],['led_off','LED off']] },
    NODE_02: { name: 'Classroom', cmds: [['buzzer_on','Buzzer on'],['buzzer_off','Buzzer off']] }
  },
  // key: [label, unit, alert-above value or null]
  metrics: {
    temperature: ['Temperature','°C',35],
    humidity:    ['Humidity','%',85],
    light:       ['Light','%',null],
    motion:      ['Motion','',null],
    door:        ['Door','',null],
    rssi:        ['Signal','dBm',null]
  }
};

const $ = id => document.getElementById(id);
let nodes = [], serverUp = false, alertLog = [], lastAlertKey = {}, currentRows = [];

// ===== Data layer =====
async function api(path, opts) {
  const r = await fetch(path, opts);
  if (!r.ok) throw new Error(path + ' ' + r.status);
  return r.json();
}

async function loadNodes() {
  try { nodes = await api('/api/nodes'); serverUp = true; }
  catch (e) { serverUp = false; }
}

async function loadHistory(id) {
  try { return await api('/api/history?node=' + id + '&limit=' + CONFIG.historyLimit); }
  catch (e) { return []; }
}

async function sendCommand(id, command) {
  try {
    await api('/api/commands/set', { method: 'POST',
      headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ node_id: id, command }) });
    toast(CONFIG.nodes[id].name + ': ' + command.replace('_', ' ') + ' sent');
  } catch (e) { toast('Could not send command. Check the server connection.'); }
}

// ===== Rendering =====
function fmt(k, v) {
  if (typeof v === 'boolean') return v ? 'Detected' : 'None';
  return typeof v === 'number' ? (Number.isInteger(v) ? v : v.toFixed(1)) : v;
}
function exceeded(k, v) {
  const t = CONFIG.metrics[k] && CONFIG.metrics[k][2];
  return t != null && typeof v === 'number' && v > t;
}

function renderNodes() {
  const wrap = $('nodes');
  wrap.innerHTML = '';
  nodes.forEach(n => {
    const cfg = CONFIG.nodes[n.node_id] || { name: n.node_name, cmds: [] };
    const bad = Object.entries(n.readings).filter(([k, v]) => exceeded(k, v));
    const el = document.createElement('article');
    el.className = 'node' + (!n.online ? ' offline' : bad.length ? ' alert' : '');
    const rows = Object.entries(n.readings)
      .filter(([k]) => CONFIG.metrics[k] && k !== 'rssi')
      .map(([k, v]) => `<div><dt>CONFIG.metrics[k][0]</dt><ddclass="{exceeded(k, v) ? 'bad' : ''}">fmt(k,v)<small>{typeof v === 'number' ? CONFIG.metrics[k][1] : ''}</small></dd></div>`).join('');
    el.innerHTML = `<div class="node-head"><h3>${cfg.name}</h3>
      <span class="state">${!n.online ? 'Offline' : bad.length ? 'Alert' : 'Online'}</span></div>
      <div class="sub">${n.node_id} · ${n.online ? 'Signal ' + (n.readings.rssi ?? '–') + ' dBm' : 'Last seen ' + (n.last_seen || 'never').replace('T', ' ')}</div>
      <dl class="readings">${rows || '<div class="muted">No data yet</div>'}</dl><div class="cmds"></div>`;
    cfg.cmds.forEach(([cmd, label]) => {
      const b = document.createElement('button');
      b.className = 'btn'; b.textContent = label; b.disabled = !n.online;
      b.onclick = () => sendCommand(n.node_id, cmd);
      el.querySelector('.cmds').appendChild(b);
    });
    wrap.appendChild(el);
  });
}

function trackAlerts() {
  nodes.forEach(n => {
    const name = (CONFIG.nodes[n.node_id] || {}).name || n.node_id;
    const issues = [];
    if (!n.online) issues.push(['offline', name + ' went offline']);
    Object.entries(n.readings).forEach(([k, v]) => {
      if (exceeded(k, v)) issues.push([k, `${name}: ${CONFIG.metrics[k][0].toLowerCase()} is ${fmt(k, v)} ${CONFIG.metrics[k][1]}, above ${CONFIG.metrics[k][2]}`]);
    });
    const keys = issues.map(i => i[0]).join();
    if (keys && lastAlertKey[n.node_id] !== keys) {
      issues.forEach(i => alertLog.unshift({ time: new Date().toLocaleTimeString(), text: i[1] }));
    }
    lastAlertKey[n.node_id] = keys;
  });
  alertLog = alertLog.slice(0, 30);
  $('alerts').innerHTML = alertLog.length
    ? alertLog.map(a => `<li>a.text<time>{a.time}</time></li>`).join('')
    : '<li class="muted">No alerts so far.</li>';
}

// ===== Chart (plain canvas, no libraries, works offline on the ESP32) =====
function drawChart(rows, metric) {
  const c = $('chart'), dpr = window.devicePixelRatio || 1;
  const w = c.clientWidth, h = 240;
  c.width = w * dpr; c.height = h * dpr;
  const g = c.getContext('2d'); g.scale(dpr, dpr);
  const css = getComputedStyle(document.documentElement);
  const line = css.getPropertyValue('--accent'), grid = css.getPropertyValue('--line'),
        txt = css.getPropertyValue('--muted'), bad = css.getPropertyValue('--bad');
  g.clearRect(0, 0, w, h);
  const pts = rows.map(r => Number(r[metric])).filter(v => !isNaN(v));
  g.font = '12px system-ui'; g.fillStyle = txt;
  if (pts.length < 2) { g.fillText('Waiting for more readings…', 12, 24); return; }
  const thr = CONFIG.metrics[metric][2];
  let lo = Math.min(...pts), hi = Math.max(...pts);
  if (thr != null) hi = Math.max(hi, thr);
  const pad = (hi - lo || 1) * .15; lo -= pad; hi += pad;
  const L = 44, R = 10, T = 10, B = 22;
  const X = i => L + i * (w - L - R) / (pts.length - 1);
  const Y = v => T + (hi - v) * (h - T - B) / (hi - lo);
  g.strokeStyle = grid; g.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const v = lo + (hi - lo) * i / 4, y = Y(v);
    g.beginPath(); g.moveTo(L, y); g.lineTo(w - R, y); g.stroke();
    g.fillText(v.toFixed(1), 4, y + 4);
  }
  if (thr != null) {
    g.strokeStyle = bad; g.setLineDash([5, 4]);
    g.beginPath(); g.moveTo(L, Y(thr)); g.lineTo(w - R, Y(thr)); g.stroke(); g.setLineDash([]);
    g.fillStyle = bad; g.fillText('limit ' + thr, w - 70, Y(thr) - 4);
  }
  g.strokeStyle = line; g.lineWidth = 2; g.beginPath();
  pts.forEach((v, i) => i ? g.lineTo(X(i), Y(v)) : g.moveTo(X(i), Y(v)));
  g.stroke();
  g.fillStyle = txt;
  const first = (rows[0].timestamp || '').slice(11, 19), last = (rows[rows.length - 1].timestamp || '').slice(11, 19);
  g.fillText(first, L, h - 6); g.fillText(last, w - R - 50, h - 6);
}

function renderHistory(rows) {
  const keys = ['timestamp', ...Object.keys(CONFIG.metrics).filter(k => rows.some(r => k in r))];
  ('histHead').innerHTML='<tr>'+keys.map(k=>`<th>{k === 'timestamp' ? 'Time' : CONFIG.metrics[k][0]}</th>`).join('') + '</tr>';
  $('histBody').innerHTML = rows.slice(-25).reverse().map(r =>
    '<tr>' + keys.map(k => `<td>${k === 'timestamp' ? (r[k] || '').replace('T', ' ') : r[k] === undefined ? '–' : fmt(k, r[k])}</td>`).join('') + '</tr>').join('');
  return keys;
}

function downloadCsv(rows) {
  const keys = [...new Set(rows.flatMap(Object.keys))];
  const csv = [keys.join(','), ...rows.map(r => keys.map(k => r[k] ?? '').join(','))].join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
  a.download = $('chartNode').value + '_history.csv';
  a.click();
}

function toast(msg) {
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toast.id); toast.id = setTimeout(() => t.classList.remove('show'), 2600);
}

// ===== Main loop =====
async function refresh() {
  await loadNodes();
  const up = nodes.filter(n => n.online).length;
  const s = $('serverState');
  s.textContent = serverUp ? 'Server online' : 'Server unreachable';
  s.className = 'pill ' + (serverUp ? 'on' : 'off');
  $('meta').textContent = serverUp
    ? `${up} of ${nodes.length} nodes online · refreshes every ${CONFIG.refreshMs / 1000} s · updated ${new Date().toLocaleTimeString()}`
    : 'Cannot reach the server. Retrying…';
  renderNodes(); trackAlerts();
  await refreshChart();
}

async function refreshChart() {
  const id = $('chartNode').value, metric = $('chartMetric').value;
  currentRows = await loadHistory(id);
  const have = Object.keys(CONFIG.metrics).filter(k => currentRows.some(r => k in r));
  const sel = $('chartMetric');
  if (sel.dataset.node !== id) {
    sel.innerHTML = have.map(k => `<option value="k">{CONFIG.metrics[k][0]}</option>`).join('');
    sel.dataset.node = id;
  }
  drawChart(currentRows, sel.value || have[0]);
  renderHistory(currentRows);
}

('chartNode').innerHTML=Object.entries(CONFIG.nodes).map(([id,n])=>`<optionvalue="{id}">${n.name}</option>`).join('');
$('chartNode').onchange = refreshChart;
$('chartMetric').onchange = refreshChart;
$('csvBtn').onclick = () => currentRows.length ? downloadCsv(currentRows) : toast('No readings to export yet.');
window.addEventListener('resize', () => refreshChart());
refresh();
setInterval(refresh, CONFIG.refreshMs);
</script>
</body>
</html>
)rawliteral";

// ---------- Helpers ----------
String nowString() {
  struct tm t;
  if (!getLocalTime(&t, 0)) return "1970-01-01T00:00:00";
  char b[20];
  strftime(b, sizeof(b), "%Y-%m-%dT%H:%M:%S", &t);
  return String(b);
}

bool ntpSynced() { return time(nullptr) > 1700000000; }

int findNode(const String& id) {
  for (int i = 0; i < NODE_COUNT; i++) if (id == NODE_IDS[i]) return i;
  return -1;
}

bool isOnline(int i) {
  return nodes[i].seen && (millis() - nodes[i].lastSeenMs) < NODE_TIMEOUT_MS;
}

void sendJson(int code, const String& body) {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  server.send(code, "application/json", body);
}

void sendError(int code, const char* msg) {
  sendJson(code, String("{\"error\":\"") + msg + "\"}");
}

String logPath(int i) { return String("/log_") + NODE_IDS[i] + ".jsonl"; }

// Append one reading to the node's log file (one JSON object per line)
void appendLog(int i, const String& line) {
  File f = LittleFS.open(logPath(i), FILE_APPEND);
  if (!f) { Serial.println("Log open failed"); return; }
  f.println(line);
  size_t size = f.size();
  f.close();
  if (size > LOG_MAX_BYTES) {                   // simple rotation keeps flash from filling up
    String old = logPath(i) + ".old";
    LittleFS.remove(old);
    LittleFS.rename(logPath(i), old);
  }
}

// ---------- Dashboard page (embedded) ----------
void handleRoot() {
  server.send_P(200, "text/html", INDEX_HTML);
}

void handleNotFound() {
  sendError(404, "not found");
}

// ---------- API: node data ----------
// POST /api/data  - nodes send readings here
void handleDataPost() {
  JsonDocument doc;
  if (deserializeJson(doc, server.arg("plain"))) { sendError(400, "invalid json"); return; }
  int i = findNode(doc["node_id"] | "");
  if (i < 0) { sendError(400, "unknown node_id"); return; }

  // Keep every field except identity/time, which the server controls
  JsonDocument readings;
  for (JsonPair kv : doc.as<JsonObject>()) {
    String k = kv.key().c_str();
    if (k != "node_id" && k != "node_name" && k != "timestamp") readings[k] = kv.value();
  }
  String ts = nowString();
  String rj;
  serializeJson(readings, rj);

  nodes[i].seen = true;
  nodes[i].lastSeenMs = millis();
  nodes[i].lastSeenTime = ts;
  nodes[i].readingsJson = rj;

  JsonDocument line;                            // log line = timestamp + readings
  line["timestamp"] = ts;
  for (JsonPair kv : readings.as<JsonObject>()) line[kv.key()] = kv.value();
  String ls;
  serializeJson(line, ls);
  appendLog(i, ls);

  JsonDocument res;
  res["ack"] = true;
  res["server_time"] = ts;
  res["command"] = nodes[i].pendingCmd;
  nodes[i].pendingCmd = "";                     // delivered
  String out;
  serializeJson(res, out);
  sendJson(200, out);
}

// GET /api/nodes - status + latest readings for all nodes (used by the dashboard)
void handleNodes() {
  JsonDocument doc;
  JsonArray arr = doc.to<JsonArray>();
  for (int i = 0; i < NODE_COUNT; i++) {
    JsonObject o = arr.add<JsonObject>();
    o["node_id"] = NODE_IDS[i];
    o["node_name"] = NODE_NAMES[i];
    o["online"] = isOnline(i);
    o["last_seen"] = nodes[i].lastSeenTime;
    JsonDocument r;
    deserializeJson(r, nodes[i].readingsJson);
    o["readings"] = r.as<JsonObject>();
  }
  String out;
  serializeJson(doc, out);
  sendJson(200, out);
}

// GET /api/data?node=NODE_01 - latest readings for one node
void handleDataGet() {
  int i = findNode(server.arg("node"));
  if (i < 0) { handleNodes(); return; }
  sendJson(200, nodes[i].readingsJson);
}

// GET /api/history?node=NODE_01&limit=60 - last N logged readings
void handleHistory() {
  int i = findNode(server.hasArg("node") ? server.arg("node") : "NODE_01");
  if (i < 0) { sendError(400, "unknown node"); return; }
  int limit = constrain(server.hasArg("limit") ? server.arg("limit").toInt() : 60, 1, 200);

  std::vector<String> lines;
  File f = LittleFS.open(logPath(i), "r");
  if (f) {
    while (f.available()) {
      String l = f.readStringUntil('\n');
      l.trim();
      if (l.length() < 2) continue;
      lines.push_back(l);
      if ((int)lines.size() > limit) lines.erase(lines.begin());
    }
    f.close();
  }
  String out = "[";
  for (size_t k = 0; k < lines.size(); k++) { if (k) out += ","; out += lines[k]; }
  out += "]";
  sendJson(200, out);
}

// ---------- API: commands ----------
// POST /api/commands/set  {"node_id":"NODE_01","command":"led_on"}  (dashboard buttons)
void handleCommandSet() {
  JsonDocument doc;
  if (deserializeJson(doc, server.arg("plain"))) { sendError(400, "invalid json"); return; }
  int i = findNode(doc["node_id"] | "");
  String cmd = doc["command"] | "";
  if (i < 0 || cmd.length() == 0) { sendError(400, "need node_id and command"); return; }
  nodes[i].pendingCmd = cmd;
  sendJson(200, "{\"ok\":true}");
}

// GET /api/commands/node1 or node2 - a node asks for its pending command
void handleCommandGet(int i) {
  JsonDocument res;
  res["command"] = nodes[i].pendingCmd;
  nodes[i].pendingCmd = "";
  String out;
  serializeJson(res, out);
  sendJson(200, out);
}

// ---------- API: server info ----------
void handleStatus() {
  int online = 0;
  for (int i = 0; i < NODE_COUNT; i++) if (isOnline(i)) online++;
  JsonDocument doc;
  doc["version"] = FW_VERSION;
  doc["uptime_s"] = millis() / 1000;
  doc["ip"] = WiFi.localIP().toString();
  doc["rssi"] = WiFi.RSSI();
  doc["time"] = nowString();
  doc["ntp_synced"] = ntpSynced();
  doc["free_heap"] = ESP.getFreeHeap();
  doc["fs_used"] = LittleFS.usedBytes();
  doc["fs_total"] = LittleFS.totalBytes();
  doc["nodes_online"] = online;
  String out;
  serializeJson(doc, out);
  sendJson(200, out);
}

void handleVersion() {
  sendJson(200, String("{\"version\":\"") + FW_VERSION + "\"}");
}

// ---------- OTA: POST firmware .bin to /update ----------
void handleUpdateDone() {
  bool ok = !Update.hasError();
  sendJson(ok ? 200 : 500, ok ? "{\"ok\":true,\"rebooting\":true}" : "{\"ok\":false}");
  delay(300);
  if (ok) ESP.restart();
}

void handleUpdateUpload() {
  HTTPUpload& up = server.upload();
  if (up.status == UPLOAD_FILE_START) Update.begin(UPDATE_SIZE_UNKNOWN);
  else if (up.status == UPLOAD_FILE_WRITE) Update.write(up.buf, up.currentSize);
  else if (up.status == UPLOAD_FILE_END) Update.end(true);
}

// ---------- Setup / loop ----------
void connectWifi() {
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("Connecting to Wi-Fi");
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(300);
    Serial.print(".");
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("\nConnected. Open http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nWi-Fi not connected yet, will keep retrying.");
  }
}

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.printf("\nServer firmware v%s\n", FW_VERSION);

  if (!LittleFS.begin(true)) Serial.println("LittleFS mount failed");
  else Serial.printf("LittleFS: %u of %u bytes used\n", (unsigned)LittleFS.usedBytes(), (unsigned)LittleFS.totalBytes());

  connectWifi();
  configTime(GMT_OFFSET_SEC, 0, NTP_SERVER);

  server.on("/", HTTP_GET, handleRoot);
  server.on("/api/data", HTTP_POST, handleDataPost);
  server.on("/api/data", HTTP_GET, handleDataGet);
  server.on("/api/nodes", HTTP_GET, handleNodes);
  server.on("/api/history", HTTP_GET, handleHistory);
  server.on("/api/status", HTTP_GET, handleStatus);
  server.on("/api/version", HTTP_GET, handleVersion);
  server.on("/api/commands/set", HTTP_POST, handleCommandSet);
  server.on("/api/commands/node1", HTTP_GET, []() { handleCommandGet(0); });
  server.on("/api/commands/node2", HTTP_GET, []() { handleCommandGet(1); });
  server.on("/update", HTTP_POST, handleUpdateDone, handleUpdateUpload);
  server.onNotFound(handleNotFound);
  server.begin();
  Serial.println("HTTP server started");
}

void loop() {
  server.handleClient();

  // Non-blocking Wi-Fi recovery
  if (WiFi.status() != WL_CONNECTED && millis() - lastWifiTry > 10000) {
    lastWifiTry = millis();
    Serial.println("Wi-Fi lost, reconnecting...");
    WiFi.disconnect();
    WiFi.begin(WIFI_SSID, WIFI_PASS);
  }

  // Week 1 milestone: NTP time visible on the Serial Monitor
  if (millis() - lastTimePrint > 10000) {
    lastTimePrint = millis();
    Serial.printf("Time: %s  (NTP %s)\n", nowString().c_str(), ntpSynced() ? "synced" : "waiting");
  }
}
